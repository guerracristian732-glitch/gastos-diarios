# Copia este archivo como ".env" y reemplaza con tu cadena de conexión real de Neon.
# La obtienes en tu dashboard de Neon (neon.tech) > tu proyecto > "Connection string".
DATABASE_URL=postgresql://usuario:password@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Clave secreta para firmar las cookies de sesión. Pon cualquier texto largo y aleatorio.
COOKIE_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
